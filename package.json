{
  "name": "extract-your-soul-md",
  "version": "0.1.0",
  "description": "A psychological study platform that reinforces a per-user soul.md from themed studies and a swipe-card refinement loop, plus a transient no-LLM conversation-statistics tool.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "run-p dev:api dev:web",
    "dev:api": "tsx watch src/index.ts --port=4317",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "serve:prod": "node --no-warnings=ExperimentalWarning dist/index.js --port=4317",
    "typecheck:web": "tsc -p frontend/tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "node --test --no-warnings=ExperimentalWarning --import tsx \"src/**/*.test.ts\""
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^9.1.3",
    "@tanstack/react-query": "5.101.0",
    "axios": "1.18.0",
    "dotenv": "17.4.2",
    "fastify": "^5.8.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "25.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.1",
    "tsx": "4.22.1",
    "typescript": "6.0.3",
    "vite": "^8.0.0"
  }
}
