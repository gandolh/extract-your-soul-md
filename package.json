{
  "name": "extract-your-soul-md",
  "version": "0.1.0",
  "description": "Prepare personal conversation chunks for voice/personality extraction by an LLM.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node --eval \"fs.cpSync('src/web/public','dist/web/public',{recursive:true})\"",
    "start": "tsx src/index.ts",
    "web": "tsx src/index.ts --web",
    "interview": "tsx src/index.ts --interview",
    "start:prod": "node dist/index.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "dotenv": "17.4.2",
    "fastify": "^5.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.0",
    "tsx": "4.22.1",
    "typescript": "6.0.3"
  }
}
