# Paths (relative to repo root)
INPUTS_FREEFORM_DIR=inputs/freeform
INPUTS_PROCESSED_DIR=inputs/processed
CHUNKS_DIR=chunks
OUT_DIR=out
MY_NAMES_FILE=inputs/my-names.txt

# Chunking
CHUNK_TARGET_TOKENS=30000

# Noise filtering
MIN_MESSAGE_LENGTH=3
DROP_URLS=true
DROP_MEDIA_PLACEHOLDERS=true

# Ollama (fallback path only — used when running with --ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.3
