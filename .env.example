# Paths (relative to repo root)
INPUTS_FREEFORM_DIR=inputs/freeform
INPUTS_PROCESSED_DIR=inputs/processed
CHUNKS_DIR=chunks
OUT_DIR=out
MY_NAMES_FILE=inputs/my-names.txt
QUESTIONNAIRE_DIR=inputs/questionnaire
QUESTIONNAIRE_FILE=answers.md

# Web platform
DB_PATH=data/soul.sqlite
WORK_DIR=.work
SERVER_PORT=4317
# Sign session cookies. CHANGE THIS in any non-local deployment (16+ chars).
SESSION_SECRET=dev-insecure-session-secret-change-me

# Chunking
# The effective chunk budget is min(CHUNK_TARGET_TOKENS, OLLAMA_NUM_CTX - header - output).
# Invariant for the Ollama path: chunkTargetTokens + maxHeaderTokens + outputReserve < OLLAMA_NUM_CTX
# (reserves: ~600 header, ~512 output). With the 8192 default ctx the budget clamps to ~7080,
# so this 30000 target only takes full effect once OLLAMA_NUM_CTX is raised on capable hardware.
CHUNK_TARGET_TOKENS=30000

# Noise filtering
MIN_MESSAGE_LENGTH=3
DROP_URLS=true
DROP_MEDIA_PLACEHOLDERS=true

# Ollama (fallback path only — used when running with --ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Context window. 8192 is safe on any hardware (incl. WSL2). The chunk budget
# derives from this, so raising it auto-scales chunk size — the opt-in for GPUs.
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.3
