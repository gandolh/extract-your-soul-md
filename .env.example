# Paths (relative to repo root)
INPUTS_FREEFORM_DIR=inputs/freeform
INPUTS_PROCESSED_DIR=inputs/processed
CHUNKS_DIR=chunks
OUT_DIR=out
QUESTIONNAIRE_DIR=inputs/questionnaire
QUESTIONNAIRE_FILE=answers.md

# Web platform
DB_PATH=data/soul.sqlite
WORK_DIR=.work
SERVER_PORT=4317
# Sign session cookies. CHANGE THIS in any non-local deployment (16+ chars).
SESSION_SECRET=dev-insecure-session-secret-change-me

# Chunking
# The effective chunk budget is min(CHUNK_TARGET_TOKENS, OLLAMA_NUM_CTX - header - output)
# (reserves: ~768 header, ~512 output). At the default OLLAMA_NUM_CTX=32768 the budget
# reaches this full 30000 target (no clamp). Lowering OLLAMA_NUM_CTX (e.g. for a small
# local model) shrinks chunks proportionally; the stage logs when it clamps.
CHUNK_TARGET_TOKENS=30000

# Noise filtering
MIN_MESSAGE_LENGTH=3
DROP_URLS=true
DROP_MEDIA_PLACEHOLDERS=true

# Ollama — the (only) extraction backend. Defaults target Ollama Cloud.
# Cloud: set OLLAMA_API_KEY below (from https://ollama.com) and keep the defaults.
# Local: set OLLAMA_HOST=http://localhost:11434 and a local model (e.g. llama3.1:8b),
#        and leave OLLAMA_API_KEY blank.
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b-cloud
# Bearer token for Ollama Cloud. Leave blank for a local server (no auth header).
OLLAMA_API_KEY=
# Context window. The chunk budget derives from this. 32768 lets chunks reach the
# full CHUNK_TARGET_TOKENS (cloud models like gpt-oss:120b support up to 128k).
# Lower it (e.g. 8192) for a small local model that can't hold a large context.
OLLAMA_NUM_CTX=32768
# 0 = deterministic. Voice extraction is analysis, not creative writing; a fixed
# seed + temp 0 makes runs reproducible given the same model (GPU nondeterminism
# can still leak). Raise only if you want sampling variety.
OLLAMA_TEMPERATURE=0

# Eval harness (POST /api/eval): N held-out messages scored under 3 conditions
# (soul.md spec / raw examples / both), K raw example messages for conditions B+C.
EVAL_HOLDOUT_N=8
EVAL_RAW_K=5
